{
  "info": {
    "name": "Image Service API",
    "description": "Register, upload, search, retrieve and delete images.\n\nRun the collection top to bottom (Collection Runner, or newman). Step 1 registers an image, step 3 uploads the file straight to S3 with the signed form from step 1, and step 4 polls until the S3-triggered processor has verified it. Every later request reuses the captured `imageId`.\n\nBefore running, set `baseUrl` from `terraform -chdir=terraform output -raw api_base_url`. The upload step sends `docs/sample.png` (70 bytes, matching `fileSize`), resolved against Postman's working directory - set that to the repository root, or pick another PNG and set `fileSize` to its exact size in bytes.\n\nFrom the command line:\n`npx newman run docs/postman_collection.json --env-var baseUrl=$(terraform -chdir=terraform output -raw api_base_url)`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4566/restapis/REPLACE_ME/local/_user_request_",
      "description": "terraform -chdir=terraform output -raw api_base_url"
    },
    {
      "key": "userId",
      "value": "alice",
      "description": "Development stand-in for an authenticated identity."
    },
    {
      "key": "fileSize",
      "value": "70",
      "description": "Exact size in bytes of the file sent in step 3. docs/sample.png is 70."
    },
    {
      "key": "imageId",
      "value": "",
      "description": "Captured in step 1."
    },
    {
      "key": "uploadUrl",
      "value": "",
      "description": "Captured in step 1."
    },
    {
      "key": "uploadForm",
      "value": "",
      "description": "Captured in step 1: the whole signed upload form, as JSON."
    },
    {
      "key": "pollAttempts",
      "value": "0",
      "description": "Step 4's retry counter."
    }
  ],
  "item": [
    {
      "name": "1. Register image",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const { image, upload } = pm.response.json();",
              "pm.test('image starts pending', () => pm.expect(image.status).to.eql('pending'));",
              "pm.test('records the uploader', () => pm.expect(image.userId).to.eql(pm.collectionVariables.get('userId')));",
              "pm.test('returns a POST form for S3', () => {",
              "  pm.expect(upload.method).to.eql('POST');",
              "  pm.expect(upload.fields).to.include.keys('key', 'policy', 'Content-Type');",
              "});",
              "pm.test('hides storage internals', () => pm.expect(image).to.not.have.property('s3Key'));",
              "pm.collectionVariables.set('imageId', image.imageId);",
              "pm.collectionVariables.set('uploadUrl', upload.url);",
              "pm.collectionVariables.set('uploadForm', JSON.stringify(upload));",
              "pm.collectionVariables.set('pollAttempts', 0);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"filename\": \"sample.png\",\n  \"contentType\": \"image/png\",\n  \"sizeBytes\": {{fileSize}},\n  \"tags\": [\"beach\", \"sunset\"],\n  \"description\": \"Golden hour\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/images",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "images"
          ]
        },
        "description": "Records the metadata with status `pending` and returns a presigned S3 POST form. No bytes are sent. `sizeBytes` must be the exact size of the file chosen in step 3."
      }
    },
    {
      "name": "2. Download before the upload - 409",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 while pending', () => pm.response.to.have.status(409));",
              "pm.test('code is ImageNotReady', () => pm.expect(pm.response.json().code).to.eql('ImageNotReady'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/images/{{imageId}}/content",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "images",
            "{{imageId}}",
            "content"
          ]
        },
        "description": "Only ready images have content."
      }
    },
    {
      "name": "3. Upload the file straight to S3",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// The signed fields vary with the credentials that signed them, so the",
              "// form is rebuilt from the registration response rather than hard-coded.",
              "// S3 requires the file to be the last field.",
              "const upload = JSON.parse(pm.collectionVariables.get('uploadForm'));",
              "const file = pm.request.body.formdata.find((param) => param.key === upload.fileField);",
              "pm.request.body.formdata.clear();",
              "Object.entries(upload.fields).forEach(([key, value]) => {",
              "  pm.request.body.formdata.add({ key, value, type: 'text' });",
              "});",
              "pm.request.body.formdata.add({ key: upload.fileField, type: 'file', src: file.src });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('S3 accepts the upload', () => pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "docs/sample.png",
              "description": "Any PNG - set fileSize to its exact size in bytes first."
            }
          ]
        },
        "url": {
          "raw": "{{uploadUrl}}",
          "host": [
            "{{uploadUrl}}"
          ]
        },
        "description": "Sent to S3, not to the API. The pre-request script adds every signed field from step 1 ahead of the file. S3 enforces the policy: a file of a different size than `fileSize` is refused with 400."
      }
    },
    {
      "name": "4. Wait until the upload is verified",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Give the S3-triggered processor a moment between polls.",
              "if (Number(pm.collectionVariables.get('pollAttempts')) > 0) {",
              "  setTimeout(() => {}, 1000);",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const image = pm.response.json();",
              "const attempts = Number(pm.collectionVariables.get('pollAttempts')) + 1;",
              "pm.collectionVariables.set('pollAttempts', attempts);",
              "if (image.status === 'pending' && attempts < 30) {",
              "  // Re-run this request. Works in the collection runner and newman, not on a single Send.",
              "  postman.setNextRequest(pm.info.requestName);",
              "} else {",
              "  pm.test('image is ready', () => pm.expect(image.status).to.eql('ready'));",
              "  pm.test('checksum is recorded', () => pm.expect(image.checksumSha256).to.match(/^[0-9a-f]{64}$/));",
              "  pm.test('size matches the declaration', () => pm.expect(image.sizeBytes).to.eql(Number(pm.collectionVariables.get('fileSize'))));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/images/{{imageId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "images",
            "{{imageId}}"
          ]
        },
        "description": "Polls GET /images/{imageId} until status leaves `pending`."
      }
    },
    {
      "name": "Register - rejects the retired imageBase64 field",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
              "pm.test('names the field', () => pm.expect(pm.response.json().error).to.include('imageBase64'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"filename\": \"old-client.png\",\n  \"contentType\": \"image/png\",\n  \"sizeBytes\": 70,\n  \"imageBase64\": \"iVBORw0KGgo=\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/images",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "images"
          ]
        }
      }
    },
    {
      "name": "Register - rejects an oversized declaration",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('413 Payload Too Large', () => pm.response.to.have.status(413));",
              "pm.test('code is PayloadTooLarge', () => pm.expect(pm.response.json().code).to.eql('PayloadTooLarge'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"filename\": \"huge.png\",\n  \"contentType\": \"image/png\",\n  \"sizeBytes\": 26214400\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/images",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "images"
          ]
        }
      }
    },
    {
      "name": "List all images",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('returns a page', () => pm.expect(body).to.have.all.keys('items', 'count', 'nextToken'));",
              "pm.test('count matches the page', () => pm.expect(body.count).to.eql(body.items.length));",
              "pm.test('only ready images are listed', () => body.items.forEach((i) => pm.expect(i.status).to.eql('ready')));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/images?limit=25",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "images"
          ],
          "query": [
            {
              "key": "limit",
              "value": "25"
            }
          ]
        },
        "description": "No userId means there is no partition key to anchor on, so this is a bounded, paginated Scan."
      }
    },
    {
      "name": "List - filter by user and tag",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const items = pm.response.json().items;",
              "pm.test('every result matches both filters', () => items.forEach((i) => {",
              "  pm.expect(i.userId).to.eql(pm.collectionVariables.get('userId'));",
              "  pm.expect(i.tags).to.include('beach');",
              "}));",
              "pm.test('newest first', () => {",
              "  const dates = items.map((i) => i.uploadedAt);",
              "  pm.expect(dates).to.eql([...dates].sort().reverse());",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/images?userId={{userId}}&tag=beach&limit=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "images"
          ],
          "query": [
            {
              "key": "userId",
              "value": "{{userId}}"
            },
            {
              "key": "tag",
              "value": "beach"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        },
        "description": "userId is indexed, which turns this into a Query. A filtered page can be empty while matches remain: follow nextToken until it is null."
      }
    },
    {
      "name": "List - filter by date range",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/images?userId={{userId}}&uploadedFrom=2020-01-01T00:00:00Z&uploadedTo=2030-12-31T23:59:59Z",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "images"
          ],
          "query": [
            {
              "key": "userId",
              "value": "{{userId}}"
            },
            {
              "key": "uploadedFrom",
              "value": "2020-01-01T00:00:00Z"
            },
            {
              "key": "uploadedTo",
              "value": "2030-12-31T23:59:59Z"
            }
          ]
        },
        "description": "Combined with userId, the date range is a key condition on the GSI rather than a post-read filter."
      }
    },
    {
      "name": "List - rejects a bad cursor",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
              "pm.test('names the parameter', () => pm.expect(pm.response.json().error).to.include('nextToken'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/images?nextToken=not-a-real-token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "images"
          ],
          "query": [
            {
              "key": "nextToken",
              "value": "not-a-real-token"
            }
          ]
        }
      }
    },
    {
      "name": "Get image metadata",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const image = pm.response.json();",
              "pm.test('is the uploaded image', () => pm.expect(image.imageId).to.eql(pm.collectionVariables.get('imageId')));",
              "pm.test('is ready', () => pm.expect(image.status).to.eql('ready'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/images/{{imageId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "images",
            "{{imageId}}"
          ]
        }
      }
    },
    {
      "name": "Get image metadata - unknown id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
              "pm.test('code is NotFound', () => pm.expect(pm.response.json().code).to.eql('NotFound'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/images/00000000000000000000000000000000",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "images",
            "00000000000000000000000000000000"
          ]
        }
      }
    },
    {
      "name": "Download - follow the redirect",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Postman follows redirects by default, so this lands on the S3 response.",
              "pm.test('200 OK after the redirect', () => pm.response.to.have.status(200));",
              "pm.test('is a PNG', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('image/png'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/images/{{imageId}}/content",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "images",
            "{{imageId}}",
            "content"
          ]
        },
        "description": "302 to a presigned S3 URL. Turn off 'Automatically follow redirects' in Postman settings to inspect the 302 itself."
      }
    },
    {
      "name": "Download - URL as JSON",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('returns a signed URL', () => pm.expect(body.downloadUrl).to.include('X-Amz-Signature'));",
              "pm.test('honours expiresIn', () => pm.expect(body.expiresInSeconds).to.eql(60));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/images/{{imageId}}/content?redirect=false&expiresIn=60",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "images",
            "{{imageId}}",
            "content"
          ],
          "query": [
            {
              "key": "redirect",
              "value": "false"
            },
            {
              "key": "expiresIn",
              "value": "60"
            }
          ]
        }
      }
    },
    {
      "name": "Delete image",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('204 No Content', () => pm.response.to.have.status(204));",
              "pm.test('no body', () => pm.expect(pm.response.text()).to.be.empty);"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/images/{{imageId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "images",
            "{{imageId}}"
          ]
        }
      }
    },
    {
      "name": "Delete image - already deleted",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404, not a silent 204', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/images/{{imageId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "images",
            "{{imageId}}"
          ]
        },
        "description": "Deleting twice reports 404 rather than pretending the call did work."
      }
    }
  ]
}
